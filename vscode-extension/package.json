{
  "name": "diffinite",
  "displayName": "Diffinite: Source Code Comparison",
  "description": "Forensic source-code comparison with Winnowing fingerprints and reports for IP litigation and code audits",
  "version": "0.14.0",
  "publisher": "nash-dir",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nash-dir/diffinite"
  },
  "homepage": "https://github.com/nash-dir/diffinite",
  "bugs": {
    "url": "https://github.com/nash-dir/diffinite/issues"
  },
  "qna": "https://github.com/nash-dir/diffinite/issues",
  "icon": "icon.png",
  "keywords": [
    "diff",
    "code comparison",
    "forensic",
    "winnowing",
    "plagiarism",
    "similarity",
    "source code",
    "litigation",
    "code audit",
    "side-by-side"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Diffinite launches a local Python process that reads source trees and writes reports; enable it only after trusting the workspace."
    }
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "diffinite.compare",
        "title": "Diffinite: Compare Directories"
      },
      {
        "command": "diffinite.help",
        "title": "Diffinite: Help"
      },
      {
        "command": "diffinite.editIgnoreList",
        "title": "Diffinite: Edit Exclusion List (.diffignore)"
      }
    ],
    "configuration": {
      "title": "Diffinite",
      "properties": {
        "diffinite.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Path to a Python interpreter with the diffinite package installed."
        },
        "diffinite.defaultMode": {
          "type": "string",
          "default": "deep",
          "enum": [
            "simple",
            "deep"
          ],
          "description": "Default execution mode."
        },
        "diffinite.workers": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 32,
          "description": "Number of worker processes for parallel diff rendering."
        },
        "diffinite.noMerge": {
          "type": "boolean",
          "default": false,
          "description": "Save one report per file pair instead of a single merged report."
        },
        "diffinite.preserveTree": {
          "type": "boolean",
          "default": true,
          "description": "With No Merge, keep the original folder structure in the output. Clear for a flat folder with index.html."
        },
        "diffinite.pdfFont": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a .ttf or .otf font file for PDF text, for example C:/Windows/Fonts/malgun.ttf. Leave empty to use the built-in CJK fonts."
        },
        "diffinite.pdfLang": {
          "type": "string",
          "default": "ko",
          "enum": [
            "ko",
            "ja",
            "zh-cn",
            "en"
          ],
          "description": "Language used to select an installed system font for PDF text. Ignored when pdfFont is set."
        },
        "diffinite.batesPresets": {
          "type": "array",
          "default": [],
          "description": "Saved Bates numbering presets (prefix, suffix and starting number).",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Preset name, for example a case number."
              },
              "prefix": {
                "type": "string",
                "description": "Bates prefix, for example PLAINTIFF-."
              },
              "suffix": {
                "type": "string",
                "description": "Bates suffix, for example -CONFIDENTIAL."
              },
              "nextBatesNumber": {
                "type": "integer",
                "default": 1,
                "description": "Starting number filled in when this preset is selected. It is not updated automatically after an export; set it to the next unused number before each export."
              }
            },
            "required": [
              "name",
              "prefix"
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "typecheck": "tsc --noEmit -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "test:host": "npm run compile && node test/host/run.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.2.2",
    "ovsx": "1.0.2",
    "typescript": "^5.3.0"
  }
}
